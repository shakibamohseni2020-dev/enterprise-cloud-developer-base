{
  "Version": "2012-10-17",
  "Id": "coupons_topic_policy",
  "Statement": [
    {
      "Sid": "AllowCouponsLambdaToPublish",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::000000000000:role/coupons_lambda_role"
      },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:000000000000:coupons"
    },
    {
      "Sid": "AllowAccountToManageTopic",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::000000000000:root"
      },
      "Action": [
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:ListSubscriptionsByTopic",
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:000000000000:coupons"
    },
    {
      "Sid": "OnlyAllowEmailAndHttpSubscriptions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:sns:us-east-1:000000000000:coupons",
      "Condition": {
        "StringNotEquals": {
          "sns:Protocol": [
            "email",
            "http"
          ]
        }
      }
    }
  ]
}
